программа просит ввести вещественное число количество денег а на выводе показывает сколько их в евро или долларах
seconds = int(input("Введите количество секунд с момента старта:\n"))
hours = seconds // 3600
minutes = (seconds % 3600) // 60
secs = seconds % 60
print(f"Время с момента старта: {seconds} секунд.")
print(f"Форматированное время: {hours} ч {minutes} мин {secs} сек.")

distance = float(input("Введите расстояние (км):\n"))
speed = float(input("Введите скорость (км/ч):\n"))
consumption = float(input("Введите расход топлива (л/100 км):\n"))
time = distance / speed
total_fuel = distance / 100 * consumption
print(f"Маршрут: {distance} км, скорость {speed} км/ч")
print(f"Время в пути: {time:.2f} часов")
print(f"Расход топлива: {consumption} л/100 км")
print(f"Общий расход: {total_fuel:.2f} литров")

celsius = float(input("Введите температуру (°C): "))
fahrenheit = (celsius * 9/5) + 32
kelvin = celsius + 273.16
print(f"Температура по Цельсию: {celsius:.1f} °C")
print(f"Температура по Фаренгейту: {fahrenheit:.1f} °F")
print(f"Температура по Кельвину: {kelvin:.1f} K")
